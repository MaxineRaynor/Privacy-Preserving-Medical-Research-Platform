# Environment Configuration for Confidential Medical Research

# Network Configuration - Sepolia Testnet
# Get RPC URL from: https://infura.io, https://alchemy.com, https://www.quicknode.com
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Private Key (without 0x prefix)
# WARNING: Never commit this with a real private key!
# Use only testnet accounts with test ETH
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Deployed Contract Address
CONTRACT_ADDRESS=deployed_contract_address_here

# API Keys (optional)
INFURA_PROJECT_ID=your_infura_project_id
ETHERSCAN_API_KEY=your_etherscan_api_key

# Application Settings
ENVIRONMENT=development
DEBUG=true
REPORT_GAS=false
